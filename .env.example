# ── Contact form email ─────────────────────────────────────────────────────
# Copy this file to .env.local and fill it in. Never commit .env.local.

# Where form submissions are delivered (your inbox)
CONTACT_TO_EMAIL=you@example.com

# The "From" address on the notification. Most SMTP providers require this to
# match the authenticated account (for Gmail: the same address as SMTP_USER).
CONTACT_FROM_EMAIL="Creex Digital Website <you@example.com>"

# SMTP credentials.
# Gmail: host smtp.gmail.com, port 465, secure true, user = your Gmail address,
#        pass = a 16-character App Password (Google Account → Security → 2-Step
#        Verification → App passwords). Regular passwords do not work.
# Other providers (Zoho, Outlook, Hostinger, cPanel…) publish the same 4 values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ── Site ───────────────────────────────────────────────────────────────────
# Public URL, used for canonical links, Open Graph tags, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://www.creexdigital.com
